<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<connectionStrings>
		<add
		  name="PostgresDb"
		  connectionString="Host=localhost;Port=5432;Database=ServerList;Username=postgres;Password=CHANGE_ME"
		  providerName="Npgsql" />
	</connectionStrings>

	<appSettings>
		<!-- DB açık / kapalı -->
		<add key="UseDatabase" value="true" />
	</appSettings>

</configuration>
